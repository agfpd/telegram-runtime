    "scripts/verify-opencode-face.md",
    "tsconfig.json"
  ],
  "scripts": {
    "start": "bun src/cli.ts run",
    "self-install": "bun src/cli.ts self-install",
    "self-config": "bun src/cli.ts self-config",
    "doctor": "bun src/cli.ts doctor --json",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agfpd/iapeer": "git+https://github.com/agfpd/iapeer.git#95a08490f8f868ce39c0f89413e1ca75fb63ee24",
    "grammy": "^1.44.0"
  },
  "bundleDependencies": ["grammy", "@agfpd/iapeer"],
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "latest"
  }
}
