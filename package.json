{
  "name": "@agfpd/telegram-runtime",
  "version": "0.28.13",
  "description": "Telegram runtime-router for IAP peers.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agfpd/telegram-runtime.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "telegram-runtime": "bin/telegram-runtime"
  },
  "files": [
    "CHANGELOG.md",
    "bin/",
    "src/",
    "docs/*.md",
    "docs/ru/",
    "scripts/verify-install.ts",
    "scripts/verify-install.md",
    "scripts/verify-polling-recovery.ts",
    "scripts/verify-polling-recovery.md",
    "scripts/verify-polling-backoff.ts",
    "scripts/verify-polling-cursor.ts",
