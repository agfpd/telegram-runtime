{
  "name": "@agfpd/telegram-runtime",
  "version": "0.28.13",
  "description": "Telegram runtime-router for IAP peers.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agfpd/telegram-runtime.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "telegram-runtime": "bin/telegram-runtime"
  },
  "files": [
    "CHANGELOG.md",
    "bin/",
    "vendor/",
    "src/",
    "docs/*.md",
    "docs/ru/",
    "scripts/verify-install.ts",
    "scripts/verify-install.md",
    "scripts/verify-polling-recovery.ts",
    "scripts/verify-polling-recovery.md",
    "scripts/verify-polling-backoff.ts",
    "scripts/verify-polling-cursor.ts",
    "scripts/verify-opencode-face.ts",
    "scripts/verify-opencode-face.md",
    "tsconfig.json"
  ],
  "scripts": {
    "start": "bun src/cli.ts run",
    "self-install": "bun src/cli.ts self-install",
    "self-config": "bun src/cli.ts self-config",
    "doctor": "bun src/cli.ts doctor --json",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "vendor:generate": "bun scripts/generate-peer-profile.ts",
    "vendor:check": "bun scripts/generate-peer-profile.ts --check"
  },
  "dependencies": {
    "grammy": "^1.44.0"
  },
  "bundleDependencies": ["grammy"],
  "devDependencies": {
    "@agfpd/iapeer": "git+https://github.com/agfpd/iapeer.git#829c2e736a318d343bd7b6b45c0e073026b9e62a",
    "@types/bun": "latest",
    "typescript": "latest"
  }
}
